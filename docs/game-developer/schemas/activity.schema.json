{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://book-builder.invalid/game-api/1.1/activity.schema.json",
  "title": "Book Builder Game Package API 1.1: activity.json (screens, fields, branching)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "start",
    "screens"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "apiVersion": {
      "enum": [
        "1.0",
        "1.1"
      ]
    },
    "start": {
      "$ref": "#/$defs/id"
    },
    "variables": {
      "type": "object",
      "maxProperties": 20,
      "propertyNames": {
        "pattern": "^[a-z][a-zA-Z0-9_]{0,39}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "initial"
        ],
        "properties": {
          "initial": {
            "type": [
              "number",
              "string",
              "boolean"
            ]
          },
          "description": {
            "type": "string",
            "maxLength": 200
          }
        }
      }
    },
    "screens": {
      "type": "array",
      "minItems": 1,
      "maxItems": 80,
      "items": {
        "$ref": "#/$defs/screen"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,47}$"
    },
    "text": {
      "type": "string",
      "maxLength": 4000,
      "description": "Plain text with a small Markdown subset: paragraphs, **bold**, *italic*, - lists, and [links](https://...). API 1.1: {{answer:fieldId}} and {{var:name}} insert the reader's answer or a variable."
    },
    "tone": {
      "enum": [
        "neutral",
        "positive",
        "consider",
        "caution"
      ]
    },
    "screen": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "title"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "enum": [
            "info",
            "form",
            "perspective",
            "feedback",
            "completion"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "body": {
          "$ref": "#/$defs/text"
        },
        "image": {
          "$ref": "#/$defs/image"
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/field"
          }
        },
        "perspectives": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "label",
              "body"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60
              },
              "body": {
                "$ref": "#/$defs/text"
              },
              "image": {
                "$ref": "#/$defs/image"
              }
            }
          }
        },
        "requireAllPerspectives": {
          "type": "boolean",
          "default": false
        },
        "feedback": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/feedbackRule"
          },
          "description": "On forms: shown after Check. On completion screens (API 1.1): rules whose condition matches are shown as the result."
        },
        "effects": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/effect"
          }
        },
        "showSummary": {
          "type": "boolean",
          "default": false,
          "description": "Completion screens only: show the reader's answers back to them (never stored)."
        },
        "showScore": {
          "type": "boolean",
          "default": false,
          "description": "Completion screens only: show the knowledge-check score."
        },
        "continueLabel": {
          "type": "string",
          "maxLength": 40
        },
        "next": {
          "$ref": "#/$defs/next"
        },
        "takeaways": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "description": "API 1.1, completion screens only: short points to take away, shown as a list."
        },
        "allowSaveNotes": {
          "type": "boolean",
          "default": false,
          "description": "API 1.1, completion screens only: offer a 'Save my notes' button that downloads the answers and takeaways as a text file on the reader's device. Needs the save-notes capability."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "form"
              }
            }
          },
          "then": {
            "required": [
              "fields",
              "next"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "perspective"
              }
            }
          },
          "then": {
            "required": [
              "perspectives",
              "next"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "info",
                  "feedback"
                ]
              }
            }
          },
          "then": {
            "required": [
              "next"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "completion"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "next"
              ]
            }
          }
        },
        {
          "if": {
            "not": {
              "properties": {
                "type": {
                  "const": "form"
                }
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "fields"
              ]
            }
          }
        },
        {
          "if": {
            "not": {
              "properties": {
                "type": {
                  "const": "perspective"
                }
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "perspectives"
              ]
            }
          }
        }
      ]
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset"
      ],
      "properties": {
        "asset": {
          "type": "string",
          "pattern": "^assets/"
        },
        "alt": {
          "type": "string",
          "maxLength": 300
        }
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "label"
      ],
      "properties": {
        "value": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "description": {
          "type": "string",
          "maxLength": 400
        },
        "feedback": {
          "$ref": "#/$defs/text"
        },
        "tone": {
          "$ref": "#/$defs/tone"
        },
        "correct": {
          "type": "boolean"
        },
        "effects": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/effect"
          }
        }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "label"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "enum": [
            "single-choice",
            "multiple-choice",
            "checkbox",
            "dropdown",
            "slider",
            "text",
            "textarea",
            "cards",
            "ranking"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "help": {
          "type": "string",
          "maxLength": 400
        },
        "required": {
          "type": "boolean",
          "default": false
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/option"
          }
        },
        "multiple": {
          "type": "boolean",
          "default": false,
          "description": "cards only: allow selecting more than one card."
        },
        "minSelected": {
          "type": "integer",
          "minimum": 0,
          "maximum": 12
        },
        "maxSelected": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "scored": {
          "type": "boolean",
          "default": false,
          "description": "Knowledge questions only: the option marked correct is the verifiable answer."
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "step": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "initial": {
          "type": [
            "number",
            "boolean"
          ]
        },
        "minLabel": {
          "type": "string",
          "maxLength": 60
        },
        "maxLabel": {
          "type": "string",
          "maxLength": 60
        },
        "placeholder": {
          "type": "string",
          "maxLength": 120
        },
        "maxLength": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2000
        },
        "showIf": {
          "$ref": "#/$defs/condition"
        },
        "shuffle": {
          "type": "boolean",
          "default": false,
          "description": "API 1.1, choice and ranking fields: show the options in a random order for each play."
        },
        "hint": {
          "type": "string",
          "maxLength": 400,
          "description": "API 1.1: an optional hint the reader can open."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "single-choice",
                  "multiple-choice",
                  "dropdown",
                  "cards",
                  "ranking"
                ]
              }
            }
          },
          "then": {
            "required": [
              "options"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "slider"
              }
            }
          },
          "then": {
            "required": [
              "min",
              "max"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "checkbox",
                  "slider",
                  "text",
                  "textarea"
                ]
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "options"
              ]
            }
          }
        }
      ]
    },
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "var"
      ],
      "properties": {
        "var": {
          "type": "string"
        },
        "set": {
          "type": [
            "number",
            "string",
            "boolean"
          ]
        },
        "add": {
          "type": "number"
        }
      },
      "oneOf": [
        {
          "required": [
            "set"
          ]
        },
        {
          "required": [
            "add"
          ]
        }
      ]
    },
    "feedbackRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text"
      ],
      "properties": {
        "when": {
          "$ref": "#/$defs/condition"
        },
        "text": {
          "$ref": "#/$defs/text"
        },
        "tone": {
          "$ref": "#/$defs/tone"
        }
      }
    },
    "next": {
      "oneOf": [
        {
          "$ref": "#/$defs/id"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "default"
          ],
          "properties": {
            "rules": {
              "type": "array",
              "maxItems": 12,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "when",
                  "goto"
                ],
                "properties": {
                  "when": {
                    "$ref": "#/$defs/condition"
                  },
                  "goto": {
                    "$ref": "#/$defs/id"
                  }
                }
              }
            },
            "default": {
              "$ref": "#/$defs/id"
            }
          }
        }
      ]
    },
    "condition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "all"
          ],
          "properties": {
            "all": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/condition"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "any"
          ],
          "properties": {
            "any": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/condition"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "not"
          ],
          "properties": {
            "not": {
              "$ref": "#/$defs/condition"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "field": {
              "$ref": "#/$defs/id"
            },
            "var": {
              "type": "string"
            },
            "equals": {
              "type": [
                "string",
                "number",
                "boolean"
              ]
            },
            "notEquals": {
              "type": [
                "string",
                "number",
                "boolean"
              ]
            },
            "in": {
              "type": "array",
              "items": {
                "type": [
                  "string",
                  "number"
                ]
              }
            },
            "includes": {
              "type": "string"
            },
            "gt": {
              "type": "number"
            },
            "gte": {
              "type": "number"
            },
            "lt": {
              "type": "number"
            },
            "lte": {
              "type": "number"
            },
            "answered": {
              "type": "boolean"
            },
            "visited": {
              "$ref": "#/$defs/id"
            },
            "first": {
              "type": "string",
              "description": "API 1.1, ranking fields: true when this option is ranked first."
            }
          },
          "oneOf": [
            {
              "required": [
                "field"
              ],
              "not": {
                "required": [
                  "var"
                ]
              }
            },
            {
              "required": [
                "var"
              ],
              "not": {
                "required": [
                  "field"
                ]
              }
            },
            {
              "required": [
                "visited"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "field"
                    ]
                  },
                  {
                    "required": [
                      "var"
                    ]
                  }
                ]
              }
            }
          ],
          "minProperties": 1
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "score"
          ],
          "description": "API 1.1: the share of scored questions answered as the book suggests, from 0 to 1.",
          "properties": {
            "score": {
              "type": "object",
              "additionalProperties": false,
              "minProperties": 1,
              "properties": {
                "gt": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "gte": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "lt": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "lte": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            }
          }
        }
      ]
    }
  }
}
