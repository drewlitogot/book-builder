{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://book-builder.invalid/game-api/1.1/game.schema.json",
  "title": "Book Builder Game Package API 1.1: game.json (manifest)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "id",
    "title",
    "description",
    "version",
    "chapter",
    "activityType",
    "learningObjectives",
    "contentWarnings",
    "accessibility",
    "requiredCapabilities",
    "assets",
    "authors"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "apiVersion": {
      "enum": [
        "1.0",
        "1.1"
      ],
      "description": "Game Package API version this package targets. 1.1 adds personalized text, ranking, shuffle, hints, score conditions, takeaways and saved notes."
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,62}[a-z0-9]$",
      "description": "Unique, permanent identifier. Lowercase letters, digits and hyphens. Becomes part of the URL."
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 80
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "maxLength": 400
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "description": "Package version, semantic versioning (MAJOR.MINOR.PATCH)."
    },
    "chapter": {
      "type": "integer",
      "minimum": 1,
      "maximum": 60,
      "description": "Book chapter number."
    },
    "activityType": {
      "enum": [
        "knowledge-check",
        "scenario",
        "reflection",
        "practice",
        "sorting",
        "explainer"
      ]
    },
    "subjects": {
      "type": "array",
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
      }
    },
    "learningObjectives": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "string",
        "minLength": 5,
        "maxLength": 200
      }
    },
    "contentWarnings": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 100
      }
    },
    "sensitive": {
      "type": "boolean",
      "default": false,
      "description": "True for trauma, abuse, assault or crisis topics. Sensitive games must be ungraded and need at least one content warning."
    },
    "estimatedMinutes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 60
    },
    "language": {
      "const": "en-US"
    },
    "accessibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "keyboard",
        "screenReader"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 10,
          "maxLength": 400,
          "description": "Plain description of what the activity involves, for people deciding whether to start it."
        },
        "keyboard": {
          "const": true
        },
        "screenReader": {
          "const": true
        },
        "readingLevel": {
          "type": "string",
          "maxLength": 40
        },
        "notes": {
          "type": "string",
          "maxLength": 400
        }
      }
    },
    "requiredCapabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "images",
          "audio",
          "branching",
          "variables",
          "perspective-switching",
          "reflection-summary",
          "scoring",
          "save-notes"
        ]
      }
    },
    "assets": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "type"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^assets/[a-z0-9][a-z0-9_-]*(/[a-z0-9][a-z0-9_-]*)*\\.(png|jpg|jpeg|webp|gif|mp3|m4a|ogg|vtt|txt)$"
          },
          "type": {
            "enum": [
              "image",
              "audio",
              "captions",
              "transcript"
            ]
          },
          "alt": {
            "type": "string",
            "maxLength": 300,
            "description": "Required for images. Empty string only for purely decorative images."
          },
          "transcript": {
            "type": "string",
            "description": "Required for audio: path of a transcript asset."
          },
          "credit": {
            "type": "string",
            "maxLength": 200
          }
        }
      }
    },
    "authors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "role": {
            "type": "string",
            "maxLength": 80
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          }
        }
      }
    },
    "license": {
      "type": "string",
      "maxLength": 80
    },
    "icon": {
      "type": "string",
      "pattern": "^assets/[a-z0-9][a-z0-9-]*\\.(png|jpg|jpeg|webp)$",
      "description": "API 1.1: a square image asset (declared in assets) shown on activity cards."
    }
  }
}
