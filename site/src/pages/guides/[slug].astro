---
// Optional quick orientation for one chapter. Built only from existing book text (see
// tools/website.py build_guides): the outline's description, verbatim glossary entries, and the
// chapter's own headings. It points into the full chapter; it never replaces it.
import Base from "../../layouts/Base.astro";
import { guides, u } from "../../lib/data";
import type { Guide } from "../../lib/data";

export function getStaticPaths() {
  return guides.map((guide) => ({ params: { slug: guide.slug }, props: { guide } }));
}
const { guide: g } = Astro.props as { guide: Guide };
const full = u(`read/${g.slug}/`);
---
<Base title={`Quick orientation: ${g.title}`} current="read" description={`Optional orientation for Chapter ${g.n} of ${book.title}, ${g.title}.`}>
  <div class="prose guide">
    <p class="kicker">Chapter {g.n} · Quick orientation (optional)</p>
    <h1>{g.title}</h1>
    <p><a class="button primary" href={full}>Read the full chapter</a></p>
    <p class="small muted">This page only helps you find your way in. The chapter itself is complete on its own{g.sensitive ? ", and it has the full safety and support information" : ""}.</p>


    {g.terms.length > 0 && (
      <section aria-labelledby="g-terms">
        <h2 id="g-terms">If you started here: key terms</h2>
        <p class="small muted">From the <a href={u("read/glossary/")}>glossary</a>, word for word.</p>
        <dl class="guide-terms">
          {g.terms.map((t) => (<><dt>{t.term}</dt><dd>{t.definition}</dd></>))}
        </dl>
      </section>
    )}

    <section aria-labelledby="g-jump">
      <h2 id="g-jump">Go straight to</h2>
      <ul>
        {g.sections.map((s) => <li><a href={`${full}#${s.id}`}>{s.text}</a></li>)}
      </ul>
      <p class="small"><a href={full}>All sections, in the full chapter</a></p>
    </section>

    {g.related.length > 0 && (
      <section aria-labelledby="g-related">
        <h2 id="g-related">Related chapters (optional)</h2>
        <ul>{g.related.map((r) => <li><a href={u(`read/${r.slug}/`)}>Chapter {r.n}: {r.title}</a></li>)}</ul>
      </section>
    )}

    <p style="margin-top:2rem"><a class="button primary" href={full}>Read the full chapter</a> <a class="button" href={u("guides/")}>All orientations</a></p>
  </div>
</Base>
