---
import Base from "../layouts/Base.astro";
import { u } from "../lib/data";
---
<Base title="Search" current="search" description="Search the published chapters.">
  <div class="prose">
    <h1>Search</h1>
    <p>Search every published chapter. Search runs in your browser; nothing you type is sent anywhere.</p>
  </div>
  <div class="search-wrap" id="search"></div>
  <noscript><p>Search needs JavaScript. You can browse <a href={u("read/")}>all chapters</a> instead.</p></noscript>
  <link href={u("pagefind/pagefind-ui.css")} rel="stylesheet" />
  <script is:inline define:vars={{ bundle: u("pagefind/") }}>
    const s = document.createElement("script");
    s.src = bundle + "pagefind-ui.js";
    s.onload = () => {
      new PagefindUI({ element: "#search", bundlePath: bundle, showSubResults: true, showImages: false, resetStyles: false,
        translations: { placeholder: "Search the book" } });
      const q = new URLSearchParams(location.search).get("q");
      const input = document.querySelector("#search input");
      if (input) { input.setAttribute("aria-label", "Search the book"); if (q) { input.value = q; input.dispatchEvent(new Event("input")); } input.focus(); }
    };
    document.head.append(s);
  </script>
</Base>
