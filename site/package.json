{
  "name": "book-builder-site",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "astro build && pagefind --site dist",
    "build:runtime": "vite build --config runtime.vite.config.ts && cp src/game/game.css ../tools/web/runtime/game.css",
    "dev": "astro dev",
    "preview": "astro preview",
    "test": "vitest run",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.9",
    "astro": "7.4.1",
    "pagefind": "^1.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^31.0.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
